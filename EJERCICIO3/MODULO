import java.util.Scanner;

class Main {
    private double baseRectangulo;
    private double alturaRectangulo;
    private String etiquetaFigura;

    public Main(double baseRectangulo, double alturaRectangulo, String etiquetaFigura) {
        this.baseRectangulo = baseRectangulo;
        this.alturaRectangulo = alturaRectangulo;
        this.etiquetaFigura = etiquetaFigura;
    }

    public double getBaseRectangulo() { return baseRectangulo; }
    public void setBaseRectangulo(double baseRectangulo) { this.baseRectangulo = baseRectangulo; }

    public double getAlturaRectangulo() { return alturaRectangulo; }
    public void setAlturaRectangulo(double alturaRectangulo) { this.alturaRectangulo = alturaRectangulo; }

    public String getEtiquetaFigura() { return etiquetaFigura; }
    public void setEtiquetaFigura(String etiquetaFigura) { this.etiquetaFigura = etiquetaFigura; }

    public double calcularArea() {
        return baseRectangulo * alturaRectangulo;
    }

    public double calcularPerimetro() {
        return 2 * (baseRectangulo + alturaRectangulo);
    }
}

class ControlRectangulo {

    private Scanner lector = new Scanner(System.in);

    public void ejecutar() {

        System.out.println("=== GEOMETRÍA: RECTÁNGULO ===");

        System.out.print("Ingrese la base del rectángulo: ");
        double baseRectangulo = lector.nextDouble();

        System.out.print("Ingrese la altura del rectángulo: ");
        double alturaRectangulo = lector.nextDouble();

        lector.nextLine(); // limpiar salto de línea

        System.out.print("Ingrese una etiqueta de identificación: ");
        String etiquetaFigura = lector.nextLine();

        // Ahora Main ES la clase del rectángulo
        Main rectangulo = new Main(baseRectangulo, alturaRectangulo, etiquetaFigura);

        System.out.println("\n=== ATRIBUTOS DEL RECTÁNGULO ===");
        System.out.println("Base: " + rectangulo.getBaseRectangulo());
        System.out.println("Altura: " + rectangulo.getAlturaRectangulo());
        System.out.println("Etiqueta: " + rectangulo.getEtiquetaFigura());

        System.out.println("\n=== COMPORTAMIENTO 1: Calcular Área ===");
        System.out.println("El área del rectángulo es: " + rectangulo.calcularArea());

        System.out.println("\n=== COMPORTAMIENTO 2: Calcular Perímetro ===");
        System.out.println("El perímetro del rectángulo es: " + rectangulo.calcularPerimetro());

        System.out.println("\n=== FIN DEL EJERCICIO 3 ===\n");
    }
}
