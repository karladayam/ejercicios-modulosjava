import java.util.Scanner;

class Main {
    private String productoFacturado;
    private int cantidadComprada;
    private double precioPorUnidad;

    public Main(String productoFacturado, int cantidadComprada, double precioPorUnidad) {
        this.productoFacturado = productoFacturado;
        this.cantidadComprada = cantidadComprada;
        this.precioPorUnidad = precioPorUnidad;
    }

    public String getProductoFacturado() { return productoFacturado; }
    public void setProductoFacturado(String productoFacturado) { this.productoFacturado = productoFacturado; }

    public int getCantidadComprada() { return cantidadComprada; }
    public void setCantidadComprada(int cantidadComprada) { this.cantidadComprada = cantidadComprada; }

    public double getPrecioPorUnidad() { return precioPorUnidad; }
    public void setPrecioPorUnidad(double precioPorUnidad) { this.precioPorUnidad = precioPorUnidad; }

    public double calcularSubtotal() {
        return cantidadComprada * precioPorUnidad;
    }

    public double calcularTotalConIVA() {
        return calcularSubtotal() * 1.16;
    }
}


class ControlFactura {

    private Scanner lector = new Scanner(System.in);

    public void ejecutar() {

        System.out.println("=== SISTEMA DE FACTURACIÓN SIMPLE ===");

        System.out.print("Ingrese el nombre del producto: ");
        String nombreProducto = lector.nextLine();

        System.out.print("Ingrese la cantidad comprada: ");
        int cantidadComprada = lector.nextInt();

        System.out.print("Ingrese el precio unitario: ");
        double precioUnitario = lector.nextDouble();
        
        Main factura = new Main(nombreProducto, cantidadComprada, precioUnitario);

        System.out.println("\n=== DATOS DE LA FACTURA ===");
        System.out.println("Producto: " + factura.getProductoFacturado());
        System.out.println("Cantidad: " + factura.getCantidadComprada());
        System.out.println("Precio unitario: $" + factura.getPrecioPorUnidad());

        System.out.println("\n=== COMPORTAMIENTO 1: Subtotal ===");
        double subtotal = factura.calcularSubtotal();
        System.out.println("Subtotal: $" + subtotal);

        System.out.println("\n=== COMPORTAMIENTO 2: Total con IVA (16%) ===");
        double total = factura.calcularTotalConIVA();
        System.out.println("Total a pagar: $" + total);

        System.out.println("\n=== FIN DEL EJERCICIO 10 ===\n");
    }
}
