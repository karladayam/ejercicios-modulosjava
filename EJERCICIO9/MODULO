import java.util.Scanner;


class Main {
    private String nombreAnimal;
    private String especieAnimal;
    private int nivelEnergia;  // 0 a 100

    public Main(String nombreAnimal, String especieAnimal, int nivelEnergia) {
        this.nombreAnimal = nombreAnimal;
        this.especieAnimal = especieAnimal;
        this.nivelEnergia = Math.max(0, Math.min(100, nivelEnergia));
    }

    public String getNombreAnimal() { return nombreAnimal; }
    public void setNombreAnimal(String nombreAnimal) { this.nombreAnimal = nombreAnimal; }

    public String getEspecieAnimal() { return especieAnimal; }
    public void setEspecieAnimal(String especieAnimal) { this.especieAnimal = especieAnimal; }

    public int getNivelEnergia() { return nivelEnergia; }
    public void setNivelEnergia(int nivelEnergia) {
        this.nivelEnergia = Math.max(0, Math.min(100, nivelEnergia));
    }

    public String consumirEnergia(int cantidad) {
        if (cantidad <= 0) return "La cantidad debe ser mayor a cero.";

        if (nivelEnergia - cantidad < 0) {
            nivelEnergia = 0;
            return "El animal se quedó sin energía.";
        }

        nivelEnergia -= cantidad;
        return "El animal gastó energía. Energía actual: " + nivelEnergia;
    }

    public String descansar(int cantidad) {
        if (cantidad <= 0) return "La cantidad debe ser mayor a cero.";

        nivelEnergia += cantidad;

        if (nivelEnergia > 100) nivelEnergia = 100;

        return "El animal descansó y recuperó energía. Energía actual: " + nivelEnergia;
    }
}



class ControlAnimal {

    private Scanner lector = new Scanner(System.in);

    public void ejecutar() {

        System.out.println("=== CONTROL DE ANIMALES ===");

        System.out.print("Ingrese el nombre del animal: ");
        String nombreAnimal = lector.nextLine();

        System.out.print("Ingrese la especie del animal: ");
        String especieAnimal = lector.nextLine();

        System.out.print("Ingrese la energía inicial (0 a 100): ");
        int nivelEnergia = lector.nextInt();

        Main animal = new Main(nombreAnimal, especieAnimal, nivelEnergia);

        System.out.println("\n=== DATOS DEL ANIMAL ===");
        System.out.println("Nombre: " + animal.getNombreAnimal());
        System.out.println("Especie: " + animal.getEspecieAnimal());
        System.out.println("Energía actual: " + animal.getNivelEnergia());

        System.out.println("\n=== COMPORTAMIENTO 1: Consumir Energía ===");
        System.out.print("¿Cuánta energía gastó el animal? ");
        int gasto = lector.nextInt();
        System.out.println(animal.consumirEnergia(gasto));
        System.out.println("Energía restante: " + animal.getNivelEnergia());

        System.out.println("\n=== COMPORTAMIENTO 2: Descansar ===");
        System.out.print("¿Cuánta energía recuperó al descansar? ");
        int recuperacion = lector.nextInt();
        System.out.println(animal.descansar(recuperacion));
        System.out.println("Energía final: " + animal.getNivelEnergia());

        System.out.println("\n=== FIN DEL EJERCICIO 9 ===\n");
    }
}
