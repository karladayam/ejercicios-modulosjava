import java.util.Scanner;

class Main {
    private String codigo;
    private int capacidad;
    private int reservados;

    public Main(String codigo, int capacidad, int reservados) {
        this.codigo = codigo;
        this.capacidad = capacidad;
        this.reservados = reservados;
    }

    public String getCodigo() { return codigo; }
    public void setCodigo(String codigo) { this.codigo = codigo; }

    public int getCapacidad() { return capacidad; }
    public void setCapacidad(int capacidad) { this.capacidad = capacidad; }

    public int getReservados() { return reservados; }

    // COMPORTAMIENTO 1: Reservar asiento
    public boolean reservar() {
        if (reservados < capacidad) {
            reservados++;
            return true;
        }
        return false;
    }

    // COMPORTAMIENTO 2: Porcentaje de ocupación
    public double porcentajeOcupacion() {
        return (reservados * 100.0) / capacidad;
    }
}

class ControlVuelo {

    private Scanner lector = new Scanner(System.in);

    public void ejecutar() {

        System.out.println("=== SISTEMA DE RESERVAS DE VUELO ===");

        System.out.print("Ingrese el código del vuelo: ");
        String codigo = lector.nextLine();

        System.out.print("Ingrese la capacidad total del vuelo: ");
        int capacidad = lector.nextInt();

        System.out.print("Ingrese cuántos asientos ya están reservados: ");
        int reservados = lector.nextInt();

        Main vuelo = new Main(codigo, capacidad, reservados);

        System.out.println("\n=== DATOS DEL VUELO ===");
        System.out.println("Código: " + vuelo.getCodigo());
        System.out.println("Capacidad: " + vuelo.getCapacidad());
        System.out.println("Reservados actualmente: " + vuelo.getReservados());

        System.out.println("\n=== COMPORTAMIENTO 1: Intentar reservar un asiento ===");
        if (vuelo.reservar()) {
            System.out.println("Reserva exitosa. Asientos ahora reservados: " + vuelo.getReservados());
        } else {
            System.out.println("No se puede reservar. El vuelo está lleno.");
        }

        System.out.println("\n=== COMPORTAMIENTO 2: Porcentaje de ocupación ===");
        System.out.println("Ocupación actual: " + vuelo.porcentajeOcupacion() + "%");

        System.out.println("\n=== FIN DEL EJERCICIO DE VUELO ===\n");
    }
}
